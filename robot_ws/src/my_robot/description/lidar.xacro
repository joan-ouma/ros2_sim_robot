<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

      <joint name="laser_joint"  type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.09 0 0.19" rpy="0 0 0"/>
        </joint>

        
        <link name="laser_frame">
        <visual>
          <geometry>
            <cylinder length="0.055" radius="0.07"/>
          </geometry>
          <material name="black"/>
        </visual>

        <collision>
          <geometry>
            <cylinder length="0.055" radius="0.07"/>
          </geometry>
          <material name="black"/>
        </collision>

        <xacro:inertial_cylinder mass="0.1" radius="0.07" length="0.055">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        </link>
        
        <!-- ADDING A GPU LIDAR SENSOR TO THE LASER_FRAME LINK -->
        <!-- UPDATE VIRTUAL SENSOR 10Hz -->
        <!-- SAVE THE DATA (GAZEBO INTERNAL) scan TOPIC -->
        <!-- SET THE DATA FRAME TO BE THE SAME AS THE LINK FRAME -->
        <!-- THE <lidar> TAG WILL CONTAIN THE LIDAR SPECIFIC PARAMETERS -->

        <gazebo reference="laser_frame">
          <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose> <!-- sensor pose relative to the link -->
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <lidar>
              <scan>
                <horizontal>
                  <samples>360</samples>
                  <min_angle>-3.14</min_angle>
                  <max_angle>3.14</max_angle>
                </horizontal>
              </scan>

              <range>
                <min>0.3</min>
                <max>12.0</max>
              </range>
              
            </lidar>
            <topic>scan</topic>
            <gz_frame_id>laser_frame</gz_frame_id>

          </sensor>

        </gazebo>
</robot>